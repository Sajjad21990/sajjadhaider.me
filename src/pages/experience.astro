---
import Ide from '../layouts/Ide.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import { education, experience, person, resumeFile, volunteering } from '../data/profile';
---

<Ide
  file="experience.md"
  wide
  title={`Experience | ${person.name}`}
  description="Work history of Sajjad Haider Sayed: Reclaim Protocol, Nine Lights Technologies, TaskPro Services and freelance work."
>
  <article class="md">
    <h1>Experience</h1>
    <p class="lede">Five years across product engineering and cloud infrastructure, most recently at Reclaim Protocol.</p>
    <p class="actions">
      <a class="btn" href={resumeFile}><Icon name="download" size={15} /> Download resume</a>
    </p>

    <h2>Work</h2>
    <Timeline jobs={experience} />

    <h2>Volunteering</h2>
    <Timeline jobs={volunteering} />

    <h2>Education</h2>
    <ul class="rows">
      {
        education.map((e) => (
          <li>
            <span class="rows-when">{e.when}</span>
            <span class="rows-what">
              <strong>{e.title}</strong> <span>at {e.where}</span>
            </span>
            <span class="rows-note">{e.note ?? ''}</span>
          </li>
        ))
      }
    </ul>
  </article>
</Ide>
