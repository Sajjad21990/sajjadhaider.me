---
import Ide from '../../layouts/Ide.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import { person } from '../../data/profile';
---

<Ide
  file="projects/"
  wide
  title={`Projects | ${person.name}`}
  description="Hackathon projects by Sajjad Haider Sayed: BotFare, Gatepass and Paper Seal."
>
