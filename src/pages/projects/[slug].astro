---
import Ide from '../../layouts/Ide.astro';
import Icon from '../../components/Icon.astro';
import { person, projects, type Project } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const at = projects.findIndex((p) => p.slug === project.slug);
const prev = projects[(at + projects.length - 1) % projects.length];
const next = projects[(at + 1) % projects.length];
---

<Ide file={`projects/${project.slug}.md`} title={`${project.name} | ${person.name}`} description={project.oneLine}>
  <article class="md">
    <p class="meta">{project.event}</p>
    <h1>{project.name}</h1>
    <p class="lede">{project.oneLine}</p>
    <ul class="chips">
      {project.stack.map((s) => <li>'{s}'</li>)}
    </ul>
    <p class="actions">
      {
        project.links.map((l, i) => (
          <a class:list={['btn', { 'btn-primary': i === 0 }]} href={l.href}>
            {l.label} <Icon name="external" size={15} />
          </a>
        ))
      }
    </p>

    {
      project.shots[0] && (
        <figure class="shot">
          <img
            src={project.shots[0].src}
            alt={project.shots[0].alt}
            width={project.shots[0].width}
            height={project.shots[0].height}
          />
        </figure>
      )
    }

    <h2>The problem</h2>
    <p>{project.problem}</p>

    <h2>How it works</h2>
    <ol class="steps">
      {project.how.map((step) => <li>{step}</li>)}
    </ol>

    {
      project.shots.slice(1).map((shot) => (
        <figure class="shot">
          <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" />
        </figure>
      ))
    }

    {project.credit && <p class="about">{project.credit}</p>}

    <nav class="pager" aria-label="More projects">
      <a href={`/projects/${prev.slug}/`}><small>Previous project</small>{prev.name}</a>
      <a href={`/projects/${next.slug}/`}><small>Next project</small>{next.name}</a>
    </nav>
  </article>
</Ide>
