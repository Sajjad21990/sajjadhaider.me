---
import type { Job } from '../data/profile';
interface Props {
  jobs: Job[];
}
const { jobs } = Astro.props;
---

<ol class="timeline">
  {
    jobs.map((job) => (
      <li>
        <p class="timeline-when">
          <b>{job.period}</b>
          {job.place}
        </p>
        <div class="timeline-body">
          <h3>{job.role}</h3>
          <p class="timeline-org">{job.url ? <a href={job.url}>{job.company}</a> : job.company}</p>
          {job.about && <p class="about">{job.about}</p>}
          <ul>
            {job.bullets.map((b) => (
              <li>{b.text}</li>
            ))}
          </ul>
          {job.stack && <ul class="chips">{job.stack.map((s) => <li>'{s}'</li>)}</ul>}
        </div>
      </li>
    ))
  }
</ol>
